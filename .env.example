# Optional. Without credentials the app uses OpenSky's anonymous quota
# (about 100 global snapshots per day, so one refresh every 15 minutes).
# With a free OpenSky account API client, the quota is 10x higher and the
# app refreshes every 90 seconds.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Required on Vercel and other cloud hosts, whose connections OpenSky ignores.
# The app then reads the snapshot published by the "Publish flights" GitHub
# workflow instead of calling OpenSky, and the credentials above are unused:
#   https://github.com/<owner>/<repo>/releases/download/data/flights.json
FLIGHTS_SNAPSHOT_URL=

# Optional. Turns the Ships layer on: the address of the snapshot published by
# the "Publish ships" GitHub workflow, which needs a free aisstream.io key as
# the AISSTREAM_API_KEY repository secret:
#   https://github.com/<owner>/<repo>/releases/download/data/ships.json
SHIPS_SNAPSHOT_URL=

# Optional override of the refresh interval, in seconds.
FLIGHTS_REFRESH_SECONDS=
